# ─────────────────────────────────────────────────────────────────────────────
# MyGameList — Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# --- SEGURANÇA ---
# Chave secreta da sessão (qualquer string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-secreta-longa

# --- E-MAIL (recuperação de senha) ---
# Conta Gmail com "Senha de App" habilitada (não a senha normal!)
SMTP_EMAIL=seuemail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- GOOGLE OAUTH (login com Google) ---
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# APIS DE PLATAFORMAS DE JOGOS
# ─────────────────────────────────────────────────────────────────────────────

# --- STEAM (API oficial, gratuita) ---
# Obtenha em: https://steamcommunity.com/dev/apikey
# Requer conta Steam e aceite dos termos de uso da API.
# Perfil do usuário deve estar configurado como PÚBLICO para funcionar.
STEAM_API_KEY=

# --- XBOX via OpenXBL (gratuito: 150 req/hora) ---
# Cadastre-se em: https://xbl.io
# Free tier permanente, sem necessidade de cartão de crédito.
OPENXBL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NOTAS SOBRE PSN:
# A PlayStation Network NÃO possui API pública oficial gratuita.
# A integração PSN usa dados de perfil estimados de forma determinística
# baseados no psn_id do usuário. Para uma integração real com troféus PSN,
# seria necessário usar a biblioteca PSNAWP com token npsso pessoal do usuário,
# o que envolve riscos de segurança e viola os ToS da Sony.
# ─────────────────────────────────────────────────────────────────────────────


#CODIGO MASTER para se tornar ADM:
ADMIN_MASTER_CODE=

